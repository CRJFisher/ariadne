{
  "name": "@ariadnejs/skill-protocol",
  "version": "0.1.0",
  "description": "Shared triage-result, run-id, and path protocol for Ariadne self-healing skills",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "ariadne",
    "skill",
    "protocol"
  ],
  "author": "Chuck",
  "license": "ISC",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ariadnejs/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
