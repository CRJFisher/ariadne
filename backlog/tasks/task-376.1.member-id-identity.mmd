  classDef gate fill:#ece4d6,stroke:#2f3338,stroke-width:2px,color:#2f3338
  classDef good fill:#e4e9d5,stroke:#6f7a4f,stroke-width:2px,color:#2f3338
  classDef bad fill:#f3d9d2,stroke:#a8412a,stroke-width:2px,color:#2f3338

  class SRC start
  class A2,B2 mint
  class A3,B3 held
  class SAME gate
  class OK,OKC good
  class NO,NOC bad

