{
  "name": "triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Triage stage for entry-point candidates: detect, triage, finalize",
  "scripts": {
    "analyze": "node --import tsx scripts/detect_entrypoints.ts --config $HOME/.ariadne/triage-entrypoints/project_configs/core.json",
    "profile": "clinic doctor -- node --import tsx scripts/detect_entrypoints.ts --config $HOME/.ariadne/triage-entrypoints/project_configs/core.json",
    "profile:flame": "clinic flame -- node --import tsx scripts/detect_entrypoints.ts --config $HOME/.ariadne/triage-entrypoints/project_configs/core.json",
    "profile:simple": "NODE_ENV=production node --cpu-prof --cpu-prof-interval=100 --import tsx scripts/detect_entrypoints.ts --config $HOME/.ariadne/triage-entrypoints/project_configs/core.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "@ariadnejs/core": "workspace:*",
    "@ariadnejs/skill-fs": "workspace:*",
    "@ariadnejs/skill-protocol": "workspace:*",
    "@ariadnejs/types": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "clinic": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
