    "file": "/Users/chuck/.ariadne/triage-entrypoints/repos/webpack--webpack/lib/dependencies/HarmonyImportSideEffectDependency.js",
    "line": 81,
    "why": "HarmonyImportSideEffectDependency registers itself via makeSerializable without overriding serialize(), so the generic ClassSerializer.serialize(obj, context) => obj.serialize(context) call dispatches through the prototype chain directly into HarmonyImportDependency.prototype.serialize, a real runtime caller with no textual reference to the method name."
