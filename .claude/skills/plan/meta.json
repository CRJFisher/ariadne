{
  "schema_version": 1,
  "_deferred": "The flows/stores topology below still describes the pre-strip curator that wrote the registry. The planning-only flow rewrite and diagram regen land in TASK-190.22.9; only names and path-patterns are current.",
  "skill": "plan",
  "description": "Offline sweep over completed triage runs. Reads the registry, dispatches an investigator wave to author classifier and root-cause proposals for each novel issue, and emits those proposals plus on-demand impact and backlog reports. Planning-only — the deferred actuator applies proposals.",

  "flows": [
    {
      "id": "novel-to-classifier",
      "name": "Registered novel issue → classifier authored",
      "representativeness": 0.95,
      "representativeness_anchor": "purpose",
      "entry": {
        "kind": "sibling_skill_artifact",
        "skill": "triage",
        "path_pattern": "analysis_output/<project>/triage_results/<run-id>.json"
      },
      "exit": {
        "kind": "store_write",
        "target": "registry-write"
      },
      "phases": ["P1", "P3", "P5"],
      "bypasses": ["P2"],
      "diagram_anchor": "pipeline-flow",
      "is_primary": true
    },
    {
      "id": "human-wip-to-permanent",
      "name": "Operator promotes wip rows to permanent",
      "representativeness": 0.10,
      "representativeness_anchor": "self-maintenance",
      "entry": {
        "kind": "user_invocation",
        "command": "pnpm find-promotion-candidates → hand-edit status → pnpm sync-permanent-rules"
      },
      "exit": {
        "kind": "store_write",
        "target": "core-builtins"
      },
      "phases": [],
      "bypasses": ["P1", "P2", "P3", "P5"],
      "diagram_anchor": "maintenance-entries",
      "is_primary": false
    },
    {
      "id": "impact-report",
      "name": "Operator generates the impact-ranked registry snapshot",
      "representativeness": 0.05,
      "representativeness_anchor": "reporting",
      "entry": {
        "kind": "user_invocation",
        "command": "node --import tsx scripts/generate_impact_report.ts [--top-n N] [--prior <json>] [--out <md>] [--snapshot <json>]"
      },
      "exit": {
        "kind": "stdout",
        "target": "human-readable-markdown"
      },
      "phases": [],
      "bypasses": ["P1", "P2", "P3", "P5"],
      "diagram_anchor": "maintenance-entries",
      "is_primary": false
    }
  ],

  "stores": [
    {
      "id": "registry-read",
      "path": ".claude/skills/triage/known_issues/registry.json",
      "access": "read-only",
      "writer_owner": "actuator",
      "semantic_role": "filter for already-known issues; investigator context",
      "touched_by_flows": ["novel-to-classifier"]
    },
    {
      "id": "registry-write",
      "path": ".claude/skills/triage/known_issues/registry.json",
      "access": "write",
      "writer_owner": null,
      "semantic_role": "single autonomous writer of wip rows; classifier.kind, drift_detected, observed_count, observed_projects, last_seen_run, backlog_task fields. permanent rows owned by human reviewer; fixed rows owned by fix-sequencer reconciler.",
      "touched_by_flows": ["novel-to-classifier"]
    },
    {
      "id": "core-builtins",
      "path": "packages/core/src/classify_entry_points/builtins/",
      "access": "write",
      "writer_owner": null,
      "semantic_role": "rendered check_<gid>.ts files plus permanent_data.ts (regenerated by sync-permanent-rules)",
      "touched_by_flows": ["novel-to-classifier"]
    }
  ],

  "sub_agents": [
    {
      "id": "plan-strategist",
      "model": "opus",
      "max_turns": 200,
      "multiplicity": "per registered novel issue; puller bounds concurrency to 5",
      "used_in_flows": ["novel-to-classifier"]
    }
  ],

  "published_outputs": [
    {
      "id": "wip-rows",
      "path_pattern": ".claude/skills/triage/known_issues/registry.json (status=wip)",
      "schema_version": null,
      "consumed_by": ["triage", "fix-sequencer"],
      "written_by_flows": ["novel-to-classifier"]
    },
    {
      "id": "core-builtin-classifiers",
      "path_pattern": "packages/core/src/classify_entry_points/builtins/check_<gid>.ts",
      "schema_version": "BuiltinClassifierSpec",
      "consumed_by": ["triage"],
      "written_by_flows": ["novel-to-classifier"]
    }
  ],

  "external_inputs": [
    {
      "from_skill": "triage",
      "path_pattern": "analysis_output/<project>/triage_results/<run-id>.json",
      "read_by_flows": ["novel-to-classifier"]
    }
  ],

  "downstream_consumers": ["fix-sequencer", "triage"]
}
