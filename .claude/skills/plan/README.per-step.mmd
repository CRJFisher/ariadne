flowchart TD
  classDef ext        fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px,color:#0d47a1
  classDef store      fill:#ede7f6,stroke:#4527a0,stroke-width:1.5px,color:#311b92
  classDef artifact   fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.2px,color:#1b5e20
  classDef step       fill:#fff8e1,stroke:#b58900,stroke-width:1.5px,color:#5d4037
  classDef agent      fill:#ffe5ec,stroke:#c2185b,stroke-width:1.5px,color:#5a0922
  classDef inter      fill:#f5f5f5,stroke:#616161,stroke-width:1px,color:#212121,stroke-dasharray:3 3
  classDef published  fill:#a8e6a3,stroke:#0e5510,stroke-width:3px,color:#062c08
  classDef downstream fill:#e5e7eb,stroke:#374151,stroke-width:1px,color:#111827
  classDef boundary   fill:#fecaca,stroke:#991b1b,stroke-width:2.5px,color:#7f1d1d

  TR[/"triage · analysis_output/&lt;p&gt;/<br/>triage_results/&lt;run-id&gt;.json<br/>schema v5 · novel_issues[]"/]:::ext

  MO[("~/.ariadne/plan/membership_overrides.json<br/><i>mis-routed members · keyed on (file,name,kind)</i>")]:::store

  subgraph PA["Pass A · Group (deterministic)"]
    direction TB
    SA("scripts/group_runs.ts<br/>scan_runs · flatten FP novel_issues[]<br/>derive_fault_area · follow_override_chain<br/>bucket by AriadneFaultArea"):::step
    MAN[/"staging/&lt;sweep&gt;/manifest.json<br/>scan manifest · swept project scope"/]:::artifact
    BK[/"staging/&lt;sweep&gt;/buckets/&lt;area&gt;.json<br/>PlanTaskEvidence[] · rollup<br/>(observed_count · projects · runs)<br/>other-bucket descriptions"/]:::artifact
  end

  subgraph PB["Pass B · Strategize (LLM, per bucket)"]
    direction TB
    HY("get_bucket_context.ts<br/>hydrate one fault-area bucket"):::step
    AGB[["plan-strategist<br/>opus · 1 per bucket"]]:::agent
    VAL("validate_plan.ts<br/>self-validate loop"):::step
    SP[/"staging/&lt;sweep&gt;/plans/&lt;area&gt;.json<br/>StrategistPlan · membership review<br/>architectural → fault_area → localized<br/>other → taxonomy-ext + core-fix"/]:::artifact
  end

  subgraph PC["Pass C · Reconcile + write (deterministic)"]
    direction TB
    RC("scripts/reconcile_plan.ts<br/>validate vs manifest · build_plan_tasks<br/>compute_dedup_key · record_membership_decisions<br/>find_by_dedup_key → augment | create"):::step
    PT[/"~/.ariadne/plan/tasks/&lt;id&gt;.json<br/>PlanTask rows (plan task-DB)"/]:::published
    SW[/"~/.ariadne/plan/sweeps/&lt;sweep-id&gt;.jsonl<br/>PlanSweepEvent log"/]:::published
  end

  EXP[["export adapter<br/>user-invoked · sole backlog writer"]]:::downstream
  FW["backlog/ write boundary<br/>plan NEVER writes backlog/ · registry.json · packages/core"]:::boundary

  TR --> SA
  MO -. "read · follow override chain" .-> SA
  SA --> MAN
  SA --> BK --> HY
  MAN -. "scan scope" .-> RC
  HY --> AGB --> VAL
  VAL -- "invalid · retry" --> AGB
  VAL --> SP
  SP --> RC
  RC --> PT
  RC --> SW
  RC -. "record mis-routed members" .-> MO
  PT -. "next sweep · in-DB reconcile" .-> RC

  PT --> EXP
  SW --> EXP
  EXP == "graduation (only write into backlog/)" ==> FW

  linkStyle default stroke:#cbd5e1,stroke-width:1.5px
