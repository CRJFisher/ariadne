{
  "schema_version": 1,
  "skill": "triage-curator",
  "description": "Offline sweep over completed self-repair-pipeline runs. Audits auto-classified false-positive groups, investigates residuals, produces classifier + backlog + signal proposals, and commits the result.",

  "flows": [
    {
      "id": "novel-to-classifier",
      "name": "Novel residual group → classifier authored",
      "representativeness": 0.95,
      "representativeness_anchor": "purpose",
      "entry": {
        "kind": "sibling_skill_artifact",
        "skill": "self-repair-pipeline",
        "path_pattern": "analysis_output/<project>/triage_results/<run-id>.json"
      },
      "exit": {
        "kind": "store_write",
        "target": "registry-write"
      },
      "phases": ["P1", "P3", "P4", "P5"],
      "bypasses": ["P2"],
      "diagram_anchor": "pipeline-flow",
      "is_primary": true
    },
    {
      "id": "qa-classified-groups",
      "name": "QA already-classified groups → drift detection",
      "representativeness": 0.30,
      "representativeness_anchor": "sub-mode",
      "entry": {
        "kind": "internal_branch",
        "from_flow_id": "novel-to-classifier",
        "condition": "BR1 = 'yes · classified' (group already has registry entry)"
      },
      "exit": {
        "kind": "store_write",
        "target": "registry-write"
      },
      "phases": ["P1", "P2", "P5"],
      "bypasses": ["P3", "P4"],
      "diagram_anchor": "maintenance-flow-qa-of-already-classified-groups",
      "is_primary": false
    },
    {
      "id": "human-wip-to-permanent",
      "name": "Operator promotes wip rows to permanent",
      "representativeness": 0.10,
      "representativeness_anchor": "self-maintenance",
      "entry": {
        "kind": "user_invocation",
        "command": "pnpm find-promotion-candidates → hand-edit status → pnpm sync-permanent-rules"
      },
      "exit": {
        "kind": "store_write",
        "target": "core-builtins"
      },
      "phases": [],
      "bypasses": ["P1", "P2", "P3", "P4", "P5"],
      "diagram_anchor": "maintenance-entries",
      "is_primary": false
    }
  ],

  "stores": [
    {
      "id": "registry-read",
      "path": ".claude/skills/self-repair-pipeline/known_issues/registry.json",
      "access": "read-only",
      "writer_owner": "triage-curator",
      "semantic_role": "filter for already-known issues; investigator + QA context",
      "touched_by_flows": ["novel-to-classifier", "qa-classified-groups"]
    },
    {
      "id": "registry-write",
      "path": ".claude/skills/self-repair-pipeline/known_issues/registry.json",
      "access": "write",
      "writer_owner": null,
      "semantic_role": "single autonomous writer of wip rows; classifier.kind, drift_detected, observed_count, observed_projects, last_seen_run, backlog_task fields. permanent rows owned by human reviewer; fixed rows owned by fix-sequencer reconciler.",
      "touched_by_flows": ["novel-to-classifier", "qa-classified-groups"]
    },
    {
      "id": "core-builtins",
      "path": "packages/core/src/classify_entry_points/builtins/",
      "access": "write",
      "writer_owner": null,
      "semantic_role": "rendered check_<gid>.ts files plus permanent_data.ts (regenerated by sync-permanent-rules)",
      "touched_by_flows": ["novel-to-classifier"]
    },
    {
      "id": "backlog",
      "path": "backlog/tasks/",
      "access": "write",
      "writer_owner": null,
      "semantic_role": "signal-gap and Ariadne-bug tasks created from investigator output",
      "touched_by_flows": ["novel-to-classifier"]
    }
  ],

  "sub_agents": [
    {
      "id": "triage-curator-qa",
      "model": "sonnet",
      "max_turns": 50,
      "multiplicity": "per classified group",
      "used_in_flows": ["qa-classified-groups"]
    },
    {
      "id": "triage-curator-investigator",
      "model": "opus",
      "max_turns": 200,
      "multiplicity": "per residual or promoted group; puller bounds concurrency to 5",
      "used_in_flows": ["novel-to-classifier"]
    }
  ],

  "published_outputs": [
    {
      "id": "wip-rows",
      "path_pattern": ".claude/skills/self-repair-pipeline/known_issues/registry.json (status=wip)",
      "schema_version": null,
      "consumed_by": ["self-repair-pipeline", "fix-sequencer"],
      "written_by_flows": ["novel-to-classifier", "qa-classified-groups"]
    },
    {
      "id": "core-builtin-classifiers",
      "path_pattern": "packages/core/src/classify_entry_points/builtins/check_<gid>.ts",
      "schema_version": "BuiltinClassifierSpec",
      "consumed_by": ["self-repair-pipeline"],
      "written_by_flows": ["novel-to-classifier"]
    },
    {
      "id": "backlog-tasks",
      "path_pattern": "backlog/tasks/task-<id>.md",
      "schema_version": null,
      "consumed_by": ["fix-sequencer"],
      "written_by_flows": ["novel-to-classifier"]
    }
  ],

  "external_inputs": [
    {
      "from_skill": "self-repair-pipeline",
      "path_pattern": "analysis_output/<project>/triage_results/<run-id>.json",
      "read_by_flows": ["novel-to-classifier", "qa-classified-groups"]
    }
  ],

  "downstream_consumers": ["fix-sequencer", "self-repair-pipeline"]
}
